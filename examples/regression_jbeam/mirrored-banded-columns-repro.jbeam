{
"testpart":{
    "nodes":[
        ["id", "posX", "posY", "posZ"],
        // Synthetic regression-test fixture, not vetted by the jbeam
        // maintainer and not intended as a demo/example.
        //
        // Three columns per side, 0.08 apart, at one station. Together they
        // are wider than an x-sorting-threshold of 0.1, so where the bands
        // fall depends on which column the walk starts from.
        ["nl0", 0.40, -1.00, 0.10],
        ["nl1", 0.40, -1.00, 0.50],
        ["nl2", 0.48, -1.00, 0.20],
        ["nl3", 0.48, -1.00, 0.60],
        ["nl4", 0.56, -1.00, 0.30],
        ["nl5", 0.56, -1.00, 0.70],
        ["nr6", -0.40, -1.00, 0.10],
        ["nr7", -0.40, -1.00, 0.50],
        ["nr8", -0.48, -1.00, 0.20],
        ["nr9", -0.48, -1.00, 0.60],
        ["nr10", -0.56, -1.00, 0.30],
        ["nr11", -0.56, -1.00, 0.70],
    ],
    "beams":[
        ["id1:", "id2:"],
        ["nl0", "nl1"],
        ["nr6", "nr7"],
    ],
},
